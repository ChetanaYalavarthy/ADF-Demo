													"value": "@item()",
													"type": "Expression"
												},
												"schema": {
													"value": "@pipeline().parameters.schema",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"tableName": {
						"type": "array",
						"defaultValue": [
							"airlines",
							"airport",
							"cancellation",
							"unique_carriers",
							"plane"
						]
					},
					"schema": {
						"type": "string",
						"defaultValue": "dbo"
					}
				},
				"annotations": []
